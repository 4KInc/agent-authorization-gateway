# Google API key for Gemini (required for ADK agent, not needed for REST API)
GOOGLE_API_KEY=your-google-api-key-here

# Firestore persistence (set to "true" for production)
FIRESTORE_ENABLED=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Shared token secret (all services must use the same value for cross-service token verification)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_TOKEN_SECRET=

# MCP server URL (for Worker agent to connect to Gateway via MCP)
GATEWAY_MCP_URL=http://localhost:8090/mcp
